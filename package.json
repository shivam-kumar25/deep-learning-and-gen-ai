{
  "name": "studyloom-dl",
  "version": "0.1.0",
  "private": true,
  "description": "Studyloom for Deep Learning and Gen AI: notes whose PyTorch cells run on a live Python kernel, with progress, search and an exam hall.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch-path=server server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "index": "node server/indexer.js",
    "test": "node --test \"server/tests/*.test.js\""
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "lucide-react": "^1.72.0",
    "node-html-parser": "^9.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
